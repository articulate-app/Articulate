  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "desktop:compile": "node desktop/build.mjs",
    "desktop:compile:prod": "node desktop/build.mjs --production",
    "desktop:build": "npm run desktop:compile:prod && node desktop/package-mac.mjs --publish never",
    "desktop:release": "npm run desktop:compile:prod && node desktop/package-mac.mjs --publish always",
    "desktop:dev": "node desktop/build.mjs && concurrently -k -n next,electron -c blue,magenta \"next dev -H 127.0.0.1 -p 3010\" \"wait-on tcp:127.0.0.1:3010 && electron desktop/dist/main.js\"",
    "desktop:electron": "node desktop/build.mjs && electron desktop/dist/main.js",
    "desktop:devtools": "node desktop/build.mjs && ARTICULATE_DESKTOP_DEVTOOLS=1 wait-on tcp:127.0.0.1:3010 && electron desktop/dist/main.js"
  },
