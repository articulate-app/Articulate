<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Electron / Chromium require JIT and unsigned executable memory under Hardened Runtime. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Allow loading Electron helper frameworks signed by the same Developer ID. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Network for Articulate web app + Browser WebContents. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
